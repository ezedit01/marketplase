# Copiá este archivo como .env y completá con los datos de tu proyecto Supabase
# Dashboard de Supabase > Project Settings > API

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Identidad de marca (se usa en textos, títulos, mensajes de WhatsApp y previews)
VITE_APP_NAME="PUNTO"
VITE_APP_BY="by KREA"
VITE_APP_TAGLINE="El lugar digital de Sol de Julio."
