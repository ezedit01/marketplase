{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marketplase",
  "compatibility_date": "2026-09-10",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/producto/*"]
  },
  "observability": {
    "enabled": true
  }
}
